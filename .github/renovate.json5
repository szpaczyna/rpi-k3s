{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Runs as the Mend Renovate GitHub App; commits go through the GitHub API, so they are signed.
  platformCommit: "enabled",
  timezone: "Europe/Warsaw",
  // The CronJob ran on Thursdays at 23:00. The app runs every 4 hours, so a 1-hour window could be skipped entirely.
  schedule: ["* * * * 4"],
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  branchConcurrentLimit: 0,
  commitMessageSuffix: "[{{updateType}}]",
  customManagers: [
    {
      customType: "regex",
      description: "cert-manager chart version, registryUrl pinned to charts.jetstack.io",
      managerFilePatterns: ["/^cluster/helm/cert-manager/deploy$/"],
      matchStrings: ["VERSION=\"v?(?<currentValue>[0-9][^\"]*)\""],
      depNameTemplate: "cert-manager",
      registryUrlTemplate: "https://charts.jetstack.io",
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      description: "authelia chart version, registryUrl pinned to charts.authelia.com",
      managerFilePatterns: ["/^cluster/helm/authelia/deploy$/"],
      matchStrings: ["VERSION=\"(?<currentValue>[0-9][^\"]*)\""],
      depNameTemplate: "authelia",
      registryUrlTemplate: "https://charts.authelia.com",
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      description: "grafana chart version, registryUrl pinned to grafana.github.io/helm-charts",
      managerFilePatterns: ["/^cluster/helm/grafana/deploy$/"],
      matchStrings: ["VERSION=\"(?<currentValue>[0-9][^\"]*)\""],
      depNameTemplate: "grafana",
      registryUrlTemplate: "https://grafana.github.io/helm-charts",
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      description: "prometheus chart version, registryUrl pinned to prometheus-community helm-charts",
      managerFilePatterns: ["/^cluster/helm/prometheus/deploy$/"],
      matchStrings: ["VERSION=\"(?<currentValue>[0-9][^\"]*)\""],
      depNameTemplate: "prometheus",
      registryUrlTemplate: "https://prometheus-community.github.io/helm-charts",
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      description: "metallb chart version, registryUrl pinned to metallb.github.io/metallb",
      managerFilePatterns: ["/^cluster/helm/metallb/deploy$/"],
      matchStrings: ["VERSION=\"(?<currentValue>[0-9][^\"]*)\""],
      depNameTemplate: "metallb",
      registryUrlTemplate: "https://metallb.github.io/metallb",
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      description: "groundhog2k/postgres chart version, registryUrl pinned to groundhog2k.github.io/helm-charts",
      managerFilePatterns: ["/^cluster/helm/postgresql/deploy$/"],
      matchStrings: ["VERSION=\"(?<currentValue>[0-9][^\"]*)\""],
      depNameTemplate: "postgres",
      registryUrlTemplate: "https://groundhog2k.github.io/helm-charts",
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      description: "traefik chart version, registryUrl pinned to traefik.github.io/charts",
      managerFilePatterns: ["/^cluster/helm/traefik-external/deploy$/", "/^cluster/helm/traefik-internal/deploy$/"],
      matchStrings: ["VERSION=\"(?<currentValue>[0-9][^\"]*)\""],
      depNameTemplate: "traefik",
      registryUrlTemplate: "https://traefik.github.io/charts",
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      description: "helm/loki/deploy: loki chart version, registryUrl pinned to grafana.github.io/helm-charts",
      managerFilePatterns: ["/^cluster/helm/loki/deploy$/"],
      matchStrings: ["LOKI_VERSION=\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "loki",
      registryUrlTemplate: "https://grafana.github.io/helm-charts",
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      description: "helm/loki/deploy: fluent-bit chart version, registryUrl pinned to fluent.github.io/helm-charts",
      managerFilePatterns: ["/^cluster/helm/loki/deploy$/"],
      matchStrings: ["FLUENT_BIT_VERSION=\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "fluent-bit",
      registryUrlTemplate: "https://fluent.github.io/helm-charts",
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      description: "helm/longhorn/deploy: chart version pin, optional argument overrides it",
      managerFilePatterns: ["/^cluster/helm/longhorn/deploy$/"],
      matchStrings: ["VERSION=\"(?<currentValue>[0-9][^\"]*)\""],
      depNameTemplate: "longhorn",
      registryUrlTemplate: "https://charts.longhorn.io",
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      description: "x509-certificate-exporter chart version, registryUrl pinned to charts.enix.io",
      managerFilePatterns: ["/^cluster/helm/x509-certificate-exporter/deploy$/"],
      matchStrings: ["VERSION=\"(?<currentValue>[0-9][^\"]*)\""],
      depNameTemplate: "x509-certificate-exporter",
      registryUrlTemplate: "https://charts.enix.io",
      datasourceTemplate: "helm",
    },
  ],
  ignorePaths: [
    "**/*.enc",
    "**/*.enc.*",
    "**/*.md.*",
    "**/*-secret*",
    "**/*-creds*",
    "**/*pgpass*",
    "**/*-auth*",
    "cluster/helm/postgresql/**",
  ],
  packageRules: [
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["brancz/kube-rbac-proxy"],
      registryUrls: ["https://quay.io"],
    },
    {
      description: "prometheus-node-exporter takes registry quay.io from the subchart default, so values.yaml only carries the repository",
      matchManagers: ["helm-values"],
      matchFileNames: ["cluster/helm/prometheus/values.yaml"],
      matchPackageNames: ["prometheus/node-exporter"],
      registryUrls: ["https://quay.io"],
    },
    {
      description: "traefik image.repository is null on purpose so the chart picks the image; the tag follows the chart bump",
      matchManagers: ["helm-values"],
      matchFileNames: ["cluster/helm/traefik-external/values.yaml", "cluster/helm/traefik-internal/values.yaml"],
      matchPackageNames: ["null"],
      enabled: false,
    },
    {
      description: "Grafana >= 11 breaks against this cluster's datasources and provisioned dashboards; hold at 10.x until the dashboards are ported",
      matchDatasources: ["docker"],
      matchPackageNames: ["grafana/grafana"],
      enabled: false,
    },
    {
      description: "grafana chart 10.5.15 is deprecated upstream; hold at 10.5.14 until the chart migration is done",
      matchDatasources: ["helm"],
      matchDepNames: ["grafana"],
      allowedVersions: "<=10.5.14",
    },
    {
      description: "calibre-web 5.x tags on lscr.io are amd64-only single manifests, so they cannot run on this arm64 cluster; the chart is parked in ~/git/k3s-old-stuff with enabled=false",
      matchDatasources: ["docker"],
      matchPackageNames: ["lscr.io/linuxserver/calibre-web"],
      enabled: false,
    },
    {
      description: "InfluxDB is not deployed; the chart is parked in ~/git/k3s-old-stuff and 2.x is a breaking rewrite",
      matchDatasources: ["docker"],
      matchPackageNames: ["influxdb"],
      enabled: false,
    },
    {
      description: "community.docker, kubernetes.core and the docker Python package were removed from provision/ansible as unused; keep them out until a task imports them",
      matchDatasources: ["ansible", "pep621", "pypi"],
      matchPackageNames: ["community.docker", "kubernetes.core", "docker"],
      enabled: false,
    },
  ],
}
