{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],

  "enabledManagers": ["helm-values", "kubernetes", "custom.regex"],

  "helm-values": {
    "fileMatch": [
      "(^|/).*values.*\\.yaml$"
    ]
  },

  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/).*values.*\\.yaml$"],
      "matchStrings": [
        "repository:\\s*[\"']?(?<depName>[^\"'\\s]+)[\"']?\\s*\\n\\s*(?:#.*\\n\\s*)*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["(^|/).*values.*\\.yaml$"],
      "matchStrings": [
        "image:\\s*(?<depName>[a-zA-Z0-9._\\-\\/]+):(?<currentValue>[^\\s\"']+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["(^|/).*values.*\\.yaml$"],
      "matchStrings": [
        "registry:\\s*[\"']?(?<registryUrl>[^\"'\\s]+)[\"']?\\s*\\n\\s*(?:#.*\\n\\s*)*repository:\\s*[\"']?(?<depName>[^\"'\\s]+)[\"']?\\s*\\n\\s*(?:#.*\\n\\s*)*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://{{registryUrl}}"
    }
  ],

  "kubernetes": {
    "fileMatch": ["\\.ya?ml$"]
  },

  "ignorePaths": [
    "**/*.enc",
    "**/*.enc.*",
    "**/*.md.*",
    "**/*-secret*",
    "**/*-creds*",
    "**/*pgpass*",
    "**/*-auth*",
    "cluster/helm/postgresql/**"
  ],

  "packageRules": [
    {
      "matchManagers": ["helm-values", "kubernetes", "custom.regex"],
      "matchDatasources": ["docker"],
      "automerge": false,
      "separateMajorMinor": true,
      "separateMultipleMajor": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["brancz/kube-rbac-proxy"],
      "registryUrls": ["https://quay.io"]
    }
  ],

  "automerge": false,
  "prConcurrentLimit": 20,
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps"
}
