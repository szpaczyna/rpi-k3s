#!/bin/bash
set -euo pipefail

NAMESPACE="traefik"
RELEASE_NAME="traefik-internal"
CHART="traefik/traefik"
VERSION="42.0.0"

# Add helm repo
helm repo add traefik https://traefik.github.io/charts 2>/dev/null || true
helm repo update

# The Secret must exist before the Gateway references it: a missing one drops
# the whole websecure listener, not one route.
kubectl apply -f <(sops -d ./wildcard-home-tls.enc.yaml)

helm upgrade --install "${RELEASE_NAME}" "${CHART}" \
  --namespace "${NAMESPACE}" \
  --create-namespace \
  --values values.yaml \
  --version "${VERSION}"
