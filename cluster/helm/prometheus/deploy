#!/bin/bash
set -euo pipefail

NAMESPACE="monitoring"
RELEASE_NAME="prometheus"
CHART="prometheus-community/prometheus"
VERSION="29.13.0"

# Add helm repo
helm repo add prometheus-community https://prometheus-community.github.io/helm-charts 2>/dev/null || true
helm repo update

kubectl apply -f <(sops -d ../../secrets/prometheus-secret.yaml) -n "${NAMESPACE}"

# certificate.yaml (Gateway API ACME cert for prometheus.shpaq.org) is
# intentionally NOT auto-applied: there is no public DNS record for this
# host yet, so issuance would just retry forever against Let's Encrypt.
# It now renders into namespace `traefik` (same-namespace Gateway secret
# reference). Apply it manually — together with
# server.route.main.enabled=true in values.yaml and the matching
# certificateRefs entry in cluster/helm/traefik/values.yaml — once DNS
# exists. See values.yaml route.main comment for the full procedure.
# kubectl apply -f certificate.yaml

helm upgrade --install "${RELEASE_NAME}" "${CHART}" \
  --namespace "${NAMESPACE}" \
  --create-namespace \
  --values values.yaml \
  --version "${VERSION}"
