#!/bin/bash
set -euo pipefail

NAMESPACE="middlewares"
RELEASE_NAME="middlewares"
CHART="."

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

HELM_ARGS=(upgrade --install "${RELEASE_NAME}" "${CHART}"
  --namespace "${NAMESPACE}"
  --create-namespace
  --values values.yaml)

helm "${HELM_ARGS[@]}"
