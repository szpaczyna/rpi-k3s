#!/bin/bash
set -euo pipefail

NAMESPACE="middlewares"
RELEASE_NAME="middlewares"
CHART="."

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

# The chart renders into the app namespaces, so on a fresh cluster they must exist first.
for ns in $(yq -r '(.namespaces + .externalChainNamespaces + .autheliaNamespaces + .lanOnlyNamespaces) | unique | .[]' values.yaml); do
  kubectl create namespace "${ns}" --dry-run=client -o yaml | kubectl apply -f -
done

HELM_ARGS=(upgrade --install "${RELEASE_NAME}" "${CHART}"
  --namespace "${NAMESPACE}"
  --create-namespace
  --values values.yaml)

helm "${HELM_ARGS[@]}"
