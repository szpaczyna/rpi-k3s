#!/bin/bash
set -euo pipefail

NAMESPACE="cert-manager"
RELEASE_NAME="cert-manager"
CHART="jetstack/cert-manager"

VERSION="v1.21.1"
REPO_NAME="jetstack"
REPO_URL="https://charts.jetstack.io"

if [[ -n "${REPO_NAME}" ]]; then
  if ! helm repo list -o json | jq -e --arg name "${REPO_NAME}" 'any(.[]?; .name == $name)' >/dev/null; then
    helm repo add "${REPO_NAME}" "${REPO_URL}"
  fi
fi

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

HELM_ARGS=(upgrade --install "${RELEASE_NAME}" "${CHART}"
  --namespace "${NAMESPACE}"
  --create-namespace)

HELM_ARGS+=(--values values.yaml)
[[ -n "${VERSION}" ]] && HELM_ARGS+=(--version "${VERSION}")

helm "${HELM_ARGS[@]}"

# Wait for cert-manager to be ready before applying issuers
echo "Waiting 60s for cert-manager pods to be ready..."
sleep 60

kubectl apply -f letsencrypt-staging.yaml -f letsencrypt-production.yaml --validate=false
