#!/bin/bash
set -euo pipefail

NAMESPACE="media"
RELEASE_NAME="calibre"
CHART="."

# Calibre is currently retired — the chart lives in unused/ and renders
# nothing until enabled=true in values.yaml. See the revival checklist at
# the top of values.yaml (including the calibre-shpaq-org-tls certificateRef
# in cluster/helm/traefik/values.yaml).

# Add helm repo if needed (none required — chart is local)

# Deploy Calibre Web
helm upgrade --install "${RELEASE_NAME}" "${CHART}" \
  --namespace "${NAMESPACE}" \
  --create-namespace \
  "$@"
