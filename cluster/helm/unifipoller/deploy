#!/bin/bash
set -euo pipefail

NAMESPACE="monitoring"
RELEASE_NAME="unifipoller"
CHART="."

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

HELM_ARGS=(upgrade --install "${RELEASE_NAME}" "${CHART}"
  --namespace "${NAMESPACE}"
  --create-namespace
  --values values-public.yaml)

# Keep the sops value inline; bash 3.2 closes a stored process substitution fd.
helm "${HELM_ARGS[@]}" --values <(sops -d ./values.enc.yaml)
