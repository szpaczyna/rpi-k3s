#!/bin/bash
set -euo pipefail

NAMESPACE="longhorn-system"
RELEASE_NAME="longhorn"
CHART="longhorn/longhorn"

# Chart version to install. Defaults to the version pinned in values.yaml so
# a bare `./deploy` reproduces the last applied release; pass an argument to
# upgrade to a different version.
VERSION="${1:-$(yq '.chartVersion' values.yaml)}"

# Add helm repo
helm repo add longhorn https://charts.longhorn.io 2>/dev/null || true
helm repo update

helm upgrade --install "${RELEASE_NAME}" "${CHART}" \
  --namespace "${NAMESPACE}" \
  --create-namespace \
  --values values.yaml \
  --version "${VERSION}"

kubectl apply -f <(sops -d ./auth.enc.yaml) -n "${NAMESPACE}"
