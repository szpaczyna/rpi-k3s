#!/bin/bash
set -euo pipefail

NAMESPACE="longhorn-system"
RELEASE_NAME="longhorn"
CHART="longhorn/longhorn"

# Pass an argument to upgrade to a version other than the pinned one.
VERSION="1.13.0"
[[ $# -gt 0 ]] && VERSION="$1"

REPO_NAME="longhorn"
REPO_URL="https://charts.longhorn.io"

if [[ -n "${REPO_NAME}" ]]; then
  if ! helm repo list -o json | jq -e --arg name "${REPO_NAME}" 'any(.[]?; .name == $name)' >/dev/null; then
    helm repo add "${REPO_NAME}" "${REPO_URL}"
  fi
fi

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

kubectl apply -f <(sops -d ./auth.enc.yaml) -n "${NAMESPACE}"

HELM_ARGS=(upgrade --install "${RELEASE_NAME}" "${CHART}"
  --namespace "${NAMESPACE}"
  --create-namespace)

HELM_ARGS+=(--values values.yaml)
[[ -n "${VERSION}" ]] && HELM_ARGS+=(--version "${VERSION}")

helm "${HELM_ARGS[@]}"

# The control plane runs on 3.8 GB and hosts no application workloads, so it
# must not store volume replicas. The chart cannot express per-node
# allowScheduling, and the setting lives on the Longhorn Node CR, so it is
# applied here. Idempotent: the CR already exists, this only pins the field.
for node in $(yq -r '.storageNodes.exclude[]' values.yaml); do
  kubectl -n "${NAMESPACE}" patch "nodes.longhorn.io/${node}" \
    --type merge -p '{"spec":{"allowScheduling":false}}'
done
