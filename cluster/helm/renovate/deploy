#!/bin/bash
set -euo pipefail

NAMESPACE="renovate"
RELEASE_NAME="renovate"
CHART="oci://ghcr.io/renovatebot/charts/renovate"
VERSION="46.395.1"

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

# The token, repository list and docker host rules live in the SOPS-encrypted
# Secret; the chart reads it via existingSecret and never renders credentials.
SECRET_FILE="./secret.enc.yaml"

echo "--> Applying secret from ${SECRET_FILE}"
kubectl apply -f <(sops -d "${SECRET_FILE}")

HELM_ARGS=(upgrade --install "${RELEASE_NAME}" "${CHART}"
  --namespace "${NAMESPACE}"
  --create-namespace)

HELM_ARGS+=(--values values.yaml)
[[ -n "${VERSION}" ]] && HELM_ARGS+=(--version "${VERSION}")

helm "${HELM_ARGS[@]}"
