#!/bin/bash
set -euo pipefail

NAMESPACE="system-upgrade"
RELEASE_NAME="system-upgrade-controller"
CHART="."

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

# k3s version the nodes should converge to, e.g. v1.37.1+k3s1. Optional first
# argument; without it the value comes from values.yaml.
VERSION="${1:-$(yq -r '.k3sVersion' values.yaml)}"

HELM_ARGS=(upgrade --install "${RELEASE_NAME}" "${CHART}"
  --namespace "${NAMESPACE}"
  --create-namespace
  --values values.yaml
  --set k3sVersion="${VERSION}")

helm "${HELM_ARGS[@]}"
