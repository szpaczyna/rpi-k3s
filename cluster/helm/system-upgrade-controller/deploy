#!/bin/bash
set -euo pipefail

NAMESPACE="system-upgrade"
RELEASE_NAME="system-upgrade-controller"
CHART="."

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

# k3s version the nodes should converge to, e.g. v1.37.1+k3s1
HELM_ARGS=(upgrade --install "${RELEASE_NAME}" "${CHART}"
  --namespace "${NAMESPACE}"
  --create-namespace
  --values values.yaml
  --set k3sVersion="${1:?Usage: ./deploy <k3s-version>  e.g. ./deploy v1.37.1+k3s1}")

helm "${HELM_ARGS[@]}"
