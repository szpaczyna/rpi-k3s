#!/bin/bash
set -euo pipefail

NAMESPACE="media"
RELEASE_NAME="homepage"
CHART="."

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

HELM_ARGS=(upgrade --install "${RELEASE_NAME}" "${CHART}"
  --namespace "${NAMESPACE}"
  --create-namespace
  --values values-public.yaml)

# The UniFi widget reuses unifipoller's controller account rather than keeping a copy.
unifi_values() {
  sops -d ../unifipoller/values.enc.yaml | yq '.upConfig' | yq -p toml -o yaml \
    '{"env": {"HOMEPAGE_VAR_UNIFI_USERNAME": .unifi.defaults.user, "HOMEPAGE_VAR_UNIFI_PASSWORD": .unifi.defaults.pass}}'
}

# Keep the sops values inline; bash 3.2 closes a stored process substitution fd.
helm "${HELM_ARGS[@]}" --values <(sops -d ./values.enc.yaml) --values <(unifi_values)
