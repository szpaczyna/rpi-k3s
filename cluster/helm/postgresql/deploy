#!/bin/bash
set -euo pipefail

NAMESPACE="apps"
RELEASE_NAME="morphine"
CHART="groundhog2k/postgres"

# Add helm repo
helm repo add groundhog2k https://groundhog2k.github.io/helm-charts/ 2>/dev/null || true
helm repo update

# Deploy PostgreSQL
helm upgrade --install "${RELEASE_NAME}" "${CHART}" \
  --namespace "${NAMESPACE}" \
  --create-namespace \
  --values values-public.yaml \
  --values <(sops -d ../../secrets/postgresql-values.yaml)

# Apply backup cronjobs
kubectl apply -f backup-job.yaml -n "${NAMESPACE}"
kubectl apply -f backup-full-job.yaml -n "${NAMESPACE}"

# Apply pgpass secret for backup jobs
kubectl apply -f <(sops -d ../../secrets/postgresql-pgpass.yaml) -n "${NAMESPACE}"
