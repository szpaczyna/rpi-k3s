#!/bin/bash
set -euo pipefail

NAMESPACE="apps"
RELEASE_NAME="morphine"
CHART="groundhog2k/postgres"

VERSION="1.6.8"
REPO_NAME="groundhog2k"
REPO_URL="https://groundhog2k.github.io/helm-charts/"

if [[ -n "${REPO_NAME}" ]]; then
  if ! helm repo list -o json | jq -e --arg name "${REPO_NAME}" 'any(.[]?; .name == $name)' >/dev/null; then
    helm repo add "${REPO_NAME}" "${REPO_URL}"
  fi
fi

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

HELM_ARGS=(upgrade --install "${RELEASE_NAME}" "${CHART}"
  --namespace "${NAMESPACE}"
  --create-namespace)

HELM_ARGS+=(--values values-public.yaml)

if [[ -n "${VERSION}" ]]; then
  helm "${HELM_ARGS[@]}" --values <(sops -d ./values.enc.yaml) --version "${VERSION}"
else
  helm "${HELM_ARGS[@]}" --values <(sops -d ./values.enc.yaml)
fi

# Apply backup cronjobs
kubectl apply -f backup-job.yaml -n "${NAMESPACE}"
kubectl apply -f backup-full-job.yaml -n "${NAMESPACE}"

