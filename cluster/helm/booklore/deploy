#!/bin/bash
set -euo pipefail

NAMESPACE="media"
RELEASE_NAME="booklore"
CHART="."

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

kubectl apply -f <(sops -d ./db-secret.enc.yaml) -n "${NAMESPACE}"

HELM_ARGS=(upgrade --install "${RELEASE_NAME}" "${CHART}"
  --namespace "${NAMESPACE}"
  --create-namespace
  --values values.yaml)

helm "${HELM_ARGS[@]}"
