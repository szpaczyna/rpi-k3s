#!/bin/bash
set -euo pipefail

NAMESPACE="traefik"
RELEASE_NAME="traefik-external"
CHART="traefik/traefik"
VERSION="42.0.0"

# Add helm repo
helm repo add traefik https://traefik.github.io/charts 2>/dev/null || true
helm repo update

# Gateway API CRDs (standard channel) come first: the chart creates
# Gateway/HTTPRoute resources and would otherwise fail on a fresh cluster.
# ./gateway-api-deploy

# TLS Secrets referenced by the websecure listener live in this namespace
# and are provisioned by each application's Helm chart (Certificate
# resources rendered into `traefik`) — nothing extra to apply here.
#
# The ingress-role label plus the matching labelSelector are what stop this
# instance and ../traefik-internal from claiming each other's Gateway.
helm upgrade --install "${RELEASE_NAME}" "${CHART}" \
  --namespace "${NAMESPACE}" \
  --create-namespace \
  --values values.yaml \
  --version "${VERSION}"
